{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NEXUS-Q Sign",
  "version": "0.1.0",
  "identifier": "org.nexusq.sign",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "NEXUS-Q Sign",
      "width": 1440,
      "height": 940,
      "minWidth": 980,
      "minHeight": 680,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Detached cryptographic document signing",
    "longDescription": "Local-first detached document signing and verification."
  }
}
